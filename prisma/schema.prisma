generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── 目的地（城市/国家） ───

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  scope       String   @default("international") // "domestic" | "international"
  country     String
  city        String?
  region      String?  // 国内: "西南"/"华东"/"华南"等; 国际: "欧洲"/"东南亚"等
  description String
  bestTime    String
  bestSeason  String?  // 春/夏/秋/冬/全年
  visa        String
  transport   String?  // 国内专属: JSON ["高铁","航班","直升机"]
  images      String   // JSON array of URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routesAsDest  Route[] @relation("RouteDestination")
  routesAsTrans Route[] @relation("RouteTransit")

  @@index([country])
  @@index([scope])
  @@index([scope, region])
}

// ─── 路线（起点 + 途经? + 终点 + 价格） ───

model Route {
  id            String   @id @default(cuid())
  slug          String   @unique
  scope         String   @default("international") // "domestic" | "international"
  name          String
  description   String
  origin        String
  transitId     String?
  destinationId String
  price         Int
  days          Int
  transportType String   @default("flight") // "flight" | "highspeed-rail" | "helicopter" | "cruise" | "car"
  imageUrl      String
  videoUrl      String?
  galleryUrls   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination  @relation("RouteDestination", fields: [destinationId], references: [id])
  transit     Destination? @relation("RouteTransit", fields: [transitId], references: [id])
  bookings    Booking[]

  @@index([destinationId])
  @@index([origin])
  @@index([price])
  @@index([scope])
}

// ─── 用户 ───

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([email])
}

// ─── 预订记录 ───

model Booking {
  id            String   @id @default(cuid())
  userId        String?  // 关联用户（可选，游客也可预订）
  routeId       String?
  guestName     String
  guestEmail    String
  guestPhone    String?
  origin        String?  // 出发城市
  destinationId String?  // 目的地 ID
  travelDate    String?
  adults        Int      @default(2)
  children      Int      @default(0)
  totalPrice    Int
  status        String   @default("submitted")
  formData      String   // JSON: 完整表单数据
  priceSnapshot String   // JSON: 价格快照
  clientToken   String?  @unique // 幂等令牌
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  route Route? @relation(fields: [routeId], references: [id])

  @@index([userId])
  @@index([routeId])
  @@index([status])
  @@index([guestEmail])
  @@index([clientToken])
}
